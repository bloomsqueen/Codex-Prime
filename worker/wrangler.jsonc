{
  // Worker des fiches d'outils et des commentaires. Aucun secret dans ce fichier.
  "name": "codex-prime-api",
  "main": "index.js",
  "compatibility_date": "2025-09-01",

  // Bucket R2 à créer vous-même, puis à mettre ici (nom à adapter si besoin).
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "codex-prime-data" }
  ],

  // Identifiants publics de Cloudflare Access (pas des secrets).
  // Tant qu'ils sont vides, TOUTE modification est refusée par le Worker.
  //   ACCESS_TEAM_DOMAIN : ex. "monequipe.cloudflareaccess.com"
  //   ACCESS_AUD         : l'« Application Audience (AUD) Tag » de l'application Access
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }

  // Route à ajouter une fois le site sur un domaine de votre compte Cloudflare, par exemple :
  // "routes": [{ "pattern": "exemple.fr/api/*", "zone_name": "exemple.fr" }]
}
